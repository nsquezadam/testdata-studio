# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------
APP_NAME=TestData Studio API # nombre de la aplicación backend
APP_ENV=development  # production
API_PREFIX=/api  # prefijo común de las rutas REST ejemplo: http://localhost:8000/api/auth/login

# ------------------------------------------------------------
# Base de datos PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/testdata_studio  # Indica a SQLAlchemy cómo conectarse con PostgreSQL

# | Parte           | Significado 
# | postgresql      | Motor de base de datos 
# | psycopg         | Driver Python que utilizamos 
# | postgres        | Usuario PostgreSQL 
# | clave           | Contraseña del usuario |
# | localhost       | PostgreSQL está en tu computador 
# | 5432            | Puerto habitual de PostgreSQL 
# | testdata_studio | Nombre de la base 

# ------------------------------------------------------------
# Seguridad JWT
# ------------------------------------------------------------
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA# clave secreta utilizada para firmar los tokens JWT

#Login correcto
#       ↓
#FastAPI genera JWT
#       ↓
#JWT se firma con JWT_SECRET
#       ↓
#Frontend guarda/utiliza token
#       ↓
#Backend verifica la firma en cada petición protegida

JWT_ALGORITHM=HS256 # algoritmo criptográfico utilizado para firmar el JWT
#JWT_SECRET
#+
#JWT_ALGORITHM

ACCESS_TOKEN_MINUTES=60 # Define durante cuánto tiempo será válido el token de acceso

# ------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------

FRONTEND_ORIGIN=http://localhost:5173  # Origen del frontend para la gestión de CORS Esta variable es muy importante cuando tengamos React funcionando

# ------------------------------------------------------------
# Usuarios iniciales para desarrollo
# ------------------------------------------------------------
# Estas variables se utilizan SOLO al ejecutar backend/scripts/seed_demo_users.py.
# Cambiar estos valores NO modifica usuarios que ya existen en la base de datos.
ADMIN_EMAIL=admin@testdata.local
ADMIN_PASSWORD=REEMPLAZAR_ADMIN

TESTER_EMAIL=tester@testdata.local
TESTER_PASSWORD=REEMPLAZAR_TESTER

# Usuarios adicionales opcionales para demostración/presentación
TESTER2_EMAIL=tester2@testdata.local
TESTER2_PASSWORD=REEMPLAZAR_TESTER2

TESTER3_EMAIL=tester3@testdata.local
TESTER3_PASSWORD=REEMPLAZAR_TESTER3

