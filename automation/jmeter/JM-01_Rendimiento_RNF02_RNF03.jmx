<hashTree/>
<DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Tiempo máximo 3000 ms" enabled="true">
  <stringProp name="DurationAssertion.duration">3000</stringProp>
</DurationAssertion>
