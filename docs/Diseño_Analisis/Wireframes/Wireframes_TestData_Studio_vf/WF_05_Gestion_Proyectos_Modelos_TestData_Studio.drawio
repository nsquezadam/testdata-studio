;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="420" height="45" as="geometry" /></mxCell><mxCell id="models_box" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="800" y="335" width="550" height="395" as="geometry" /></mxCell><mxCell id="selected_project" value="Proyecto seleccionado: &lt;b&gt;Proyecto Clientes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="330" height="28" as="geometry" /></mxCell><mxCell id="new_model" value="+ NUEVO MODELO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E6E6E6;strokeColor=#777777;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="348" width="155" height="34" as="geometry" /></mxCell><mxCell id="models_title" value="MODELOS DEL PROYECTO" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="395" width="250" height="26" as="geometry" /></mxCell><mxCell id="mth0" value="&lt;b&gt;Modelo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="190" height="34" as="geometry" /></mxCell><mxCell id="mth1" value="&lt;b&gt;Estado&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="90" height="34" as="geometry" /></mxCell><mxCell id="mth2" value="&lt;b&gt;Acciones&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="225" height="34" as="geometry" /></mxCell><mxCell id="mtd0_0" value="Cliente Natural" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="464" width="190" height="46" as="geometry" /></mxCell><mxCell id="mtd0_1" value="Activo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="464" width="90" height="46" as="geometry" /></mxCell><mxCell id="mtd0_2" value="Editar | Configurar | Desactivar" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="464" width="225" height="46" as="geometry" /></mxCell><mxCell id="mtd1_0" value="Cliente Empresa" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="510" width="190" height="46" as="geometry" /></mxCell><mxCell id="mtd1_1" value="Activo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="510" width="90" height="46" as="geometry" /></mxCell><mxCell id="mtd1_2" value="Editar | Configurar | Desactivar" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="510" width="225" height="46" as="geometry" /></mxCell><mxCell id="models_empty" value="Si el proyecto no posee modelos, mostrar “Aún no existen modelos asociados”." style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="585" width="505" height="52" as="geometry" /></mxCell><mxCell id="relation_note" value="Un modelo siempre se crea dentro del proyecto seleccionado.&lt;br&gt;RF16: Activar/Desactivar proyecto o modelo no elimina datos y genera automáticamente un registro de auditoría." style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="820" y="655" width="505" height="42" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="815" width="380" height="22" as="geometry" /></mxCell><mxCell id="notes" value="WF-05 · CU-03 · HU-03 · RF03 | Baja fidelidad | Desktop 1440×900 | Analista/Tester | Vista maestro-detalle | Proyecto → Modelo → Configurar campos/reglas | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="70" y="865" width="1300" height="25" as="geometry" /></mxCell><mxCell id="rf16_panel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="445" y="270" width="585" height="310" as="geometry" /></mxCell><mxCell id="rf16_heading" value="CONFIRMAR ACTIVACIÓN / DESACTIVACIÓN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="475" y="295" width="525" height="44" as="geometry" /></mxCell><mxCell id="rf16_desc" value="¿Confirma que desea cambiar el estado del proyecto o modelo seleccionado?&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;La información y sus históricos se conservarán. Se validarán permisos/dependencias y el cambio quedará registrado automáticamente en AUDITORIA con responsable, entidad, registro, estado anterior/nuevo y fecha/hora." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="350" width="525" height="93" as="geometry" /></mxCell><mxCell id="rf16_cancel" value="CANCELAR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="485" width="145" height="45" as="geometry" /></mxCell><mxCell id="rf16_confirm" value="CONFIRMAR CAMBIO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFDFDF;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="485" width="145" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>