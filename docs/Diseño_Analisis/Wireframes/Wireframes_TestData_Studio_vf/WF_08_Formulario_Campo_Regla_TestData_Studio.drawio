o." style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="650" width="200" height="35" as="geometry" /></mxCell><mxCell id="typesnote" value="&lt;b&gt;Tipos de regla MVP&lt;/b&gt;&lt;br&gt;1. Obligatoriedad&lt;br&gt;2. Rango&lt;br&gt;3. Valores permitidos&lt;br&gt;4. Formato / longitud&lt;br&gt;5. Comparación entre campos&lt;br&gt;6. Condicional simple" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="300" width="240" height="170" as="geometry" /></mxCell><mxCell id="rulesnote" value="&lt;b&gt;RF07&lt;/b&gt;&lt;br&gt;Antes de guardar, el sistema valida coherencia de parámetros. Ej.: en Rango, mínimo no puede ser mayor que máximo.&lt;br&gt;• El estado se visualiza como solo lectura.&lt;br&gt;• RF16: Activar/Desactivar la regla se realiza desde WF-07 y genera auditoría." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="490" width="240" height="100" as="geometry" /></mxCell><mxCell id="cancel" value="CANCELAR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="630" width="110" height="42" as="geometry" /></mxCell><mxCell id="save" value="GUARDAR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E6E6E6;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="630" width="110" height="42" as="geometry" /></mxCell><mxCell id="footnote" value="WF-08B · CU-04 · HU-04 · RF05-RF07 | F02 Campo y Regla | Baja fidelidad | Modo Regla | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="70" y="865" width="1300" height="25" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="820" width="380" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>