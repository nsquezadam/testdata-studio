38" as="geometry" /></mxCell><mxCell id="state_select" value="Activo · solo lectura" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="587" width="310" height="38" as="geometry" /></mxCell><mxCell id="validation" value="Área de mensajes y validaciones" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="340" y="650" width="670" height="38" as="geometry" /></mxCell><mxCell id="cancel_btn" value="CANCELAR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="615" width="120" height="42" as="geometry" /></mxCell><mxCell id="save_btn" value="GUARDAR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E6E6E6;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="615" width="120" height="42" as="geometry" /></mxCell><mxCell id="mode_note" value="&lt;b&gt;Modo creación&lt;/b&gt;&lt;br&gt;Nombre, apellido, correo, contraseña, confirmación y rol. El usuario se crea Activo por defecto.&lt;br&gt;&lt;br&gt;&lt;b&gt;Modo edición&lt;/b&gt;&lt;br&gt;El formulario carga los datos existentes. La contraseña solo se modifica si el administrador decide cambiarla. El estado se visualiza, pero no se modifica desde este formulario." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1100" y="245" width="250" height="220" as="geometry" /></mxCell><mxCell id="rules_note" value="&lt;b&gt;Validaciones funcionales&lt;/b&gt;&lt;br&gt;• Campos obligatorios.&lt;br&gt;• Formato de correo válido.&lt;br&gt;• Correo no duplicado.&lt;br&gt;• Contraseña y confirmación coinciden al crear/cambiar.&lt;br&gt;• Rol permitido: Administrador o Analista/Tester.&lt;br&gt;• RF16: Activar/Desactivar se realiza únicamente desde WF-03, con confirmación y registro automático en AUDITORIA." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1100" y="475" width="250" height="125" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="815" width="380" height="22" as="geometry" /></mxCell><mxCell id="notes" value="WF-04 · CU-02 · HU-02 · RF02/RNF01 | Baja fidelidad | Desktop 1440×900 | Solo Administrador | Crear/editar usuario | Asignar rol / consultar estado | Sin eliminación física | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="70" y="865" width="1300" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>