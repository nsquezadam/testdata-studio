ntSize=8;" vertex="1" parent="1"><mxGeometry x="1310" y="497" width="40" height="48" as="geometry" /></mxCell><mxCell id="r2_0" value="Formato fecha" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="545" width="150" height="48" as="geometry" /></mxCell><mxCell id="r2_1" value="Formato" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1010" y="545" width="130" height="48" as="geometry" /></mxCell><mxCell id="r2_2" value="fecha_inicio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1140" y="545" width="100" height="48" as="geometry" /></mxCell><mxCell id="r2_3" value="Activo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="545" width="70" height="48" as="geometry" /></mxCell><mxCell id="r2_4" value="E / D" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1310" y="545" width="40" height="48" as="geometry" /></mxCell><mxCell id="rule_types_note" value="&lt;b&gt;Tipos soportados en el MVP&lt;/b&gt;&lt;br&gt;Obligatorio · Rango · Valores permitidos · Formato/longitud · Comparación entre campos · Condicional simple" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="860" y="610" width="465" height="75" as="geometry" /></mxCell><mxCell id="behavior_note" value="&lt;b&gt;Flujo:&lt;/b&gt; Nuevo campo / Editar campo / Nueva regla / Editar regla → WF-08. Las reglas solo se configuran cuando existe un modelo seleccionado. Las reglas pueden asociarse a uno o más campos según su tipo.&lt;br&gt;• RF16: Activar/Desactivar campo o regla se realiza aquí, con confirmación y registro automático en AUDITORIA." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="770" width="1040" height="50" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="825" width="380" height="18" as="geometry" /></mxCell><mxCell id="notes" value="WF-07 · CU-04 · HU-04 · RF04-RF07 | M02 Campos y Reglas de Negocio | Baja fidelidad | Desktop 1440×900 | Modelo como contexto | WF-08 para alta/edición | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="70" y="865" width="1300" height="25" as="geometry" /></mxCell><mxCell id="rf16_panel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="445" y="270" width="585" height="310" as="geometry" /></mxCell><mxCell id="rf16_heading" value="CONFIRMAR ACTIVACIÓN / DESACTIVACIÓN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="475" y="295" width="525" height="44" as="geometry" /></mxCell><mxCell id="rf16_desc" value="¿Confirma que desea cambiar el estado del campo o regla seleccionado?&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;El registro se conservará para trazabilidad. Se validarán permisos/dependencias y el cambio quedará registrado automáticamente en AUDITORIA con responsable, entidad, registro, estado anterior/nuevo y fecha/hora." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="350" width="525" height="93" as="geometry" /></mxCell><mxCell id="rf16_cancel" value="CANCELAR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="485" width="145" height="45" as="geometry" /></mxCell><mxCell id="rf16_confirm" value="CONFIRMAR CAMBIO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFDFDF;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="485" width="145" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>