align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="485" width="130" height="44" as="geometry" /></mxCell><mxCell id="td_2_0" value="María Silva" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="529" width="190" height="44" as="geometry" /></mxCell><mxCell id="td_2_1" value="maria.silva@correo.cl" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="529" width="260" height="44" as="geometry" /></mxCell><mxCell id="td_2_2" value="Analista/Tester" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="529" width="180" height="44" as="geometry" /></mxCell><mxCell id="td_2_3" value="Inactivo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="529" width="130" height="44" as="geometry" /></mxCell><mxCell id="td_2_4" value="17/10/2026" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1070" y="529" width="150" height="44" as="geometry" /></mxCell><mxCell id="td_2_5" value="Editar | Activar" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="529" width="130" height="44" as="geometry" /></mxCell><mxCell id="count" value="Mostrando 3 usuarios" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="600" width="220" height="26" as="geometry" /></mxCell><mxCell id="pagination" value="‹  1  2  3  ›" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#B7B7B7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="190" height="30" as="geometry" /></mxCell><mxCell id="behavior_note" value="&lt;b&gt;Comportamiento esperado&lt;/b&gt;&lt;br&gt;• No se elimina físicamente un usuario.&lt;br&gt;• Se utiliza Activar/Desactivar para controlar el acceso.&lt;br&gt;• “Nuevo usuario” y “Editar” dirigirán al WF-04.&lt;br&gt;• RF16: cada cambio confirmado registra automáticamente usuario responsable, entidad, registro, estado anterior, estado nuevo y fecha/hora." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="660" width="700" height="95" as="geometry" /></mxCell><mxCell id="empty_note" value="Estado alternativo: si no existen usuarios para el filtro aplicado, mostrar “No se encontraron usuarios”." style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1030" y="660" width="320" height="95" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="815" width="380" height="22" as="geometry" /></mxCell><mxCell id="notes" value="WF-03 · CU-02 · HU-02 · RF02/RNF01 | Baja fidelidad | Desktop 1440×900 | Solo Administrador | Buscar/filtrar | Crear/editar | Activar/desactivar | Sin eliminación física | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="75" y="865" width="1300" height="25" as="geometry" /></mxCell><mxCell id="rf16_panel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="445" y="270" width="585" height="310" as="geometry" /></mxCell><mxCell id="rf16_heading" value="CONFIRMAR ACTIVACIÓN / DESACTIVACIÓN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="475" y="295" width="525" height="44" as="geometry" /></mxCell><mxCell id="rf16_desc" value="¿Confirma que desea cambiar el estado del usuario seleccionado?&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;La información no será eliminada físicamente. Se validarán permisos y el cambio quedará registrado automáticamente en AUDITORIA con responsable, registro, estado anterior/nuevo y fecha/hora." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="350" width="525" height="93" as="geometry" /></mxCell><mxCell id="rf16_cancel" value="CANCELAR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="485" width="145" height="45" as="geometry" /></mxCell><mxCell id="rf16_confirm" value="CONFIRMAR CAMBIO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFDFDF;strokeColor=#777777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="485" width="145" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>