" height="95" as="geometry" /></mxCell><mxCell id="empty_note" value="Estado alternativo: si no existen usuarios para el filtro aplicado, mostrar “No se encontraron usuarios”." style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FAFAFA;strokeColor=#C9C9C9;dashed=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1030" y="660" width="320" height="95" as="geometry" /></mxCell><mxCell id="footer" value="TestData Studio · Proyecto de Título" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="650" y="815" width="380" height="22" as="geometry" /></mxCell><mxCell id="notes" value="WF-03 · CU-02 · HU-02 · RF02/RNF01 | Baja fidelidad | Desktop 1440×900 | Solo Administrador | Buscar/filtrar | Crear/editar | Activar/desactivar | Sin eliminación física | RF16 / CU-11: estado lógico sin DELETE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="75" y="865" width="1300" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="rf16-confirm-03" name="RF16 - Confirmar cambio de estado"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="screen" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1380" height="820" as="geometry" /></mxCell><mxCell id="header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1380" height="75" as="geometry" /></mxCell><mxCell id="brand" value="TESTDATA STUDIO" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=